# ─────────────────────────────────────────────────────────────────────────
# 環境變數範例
#
# 使用方式：`cp .env.example .env`，再依需求修改。
#
# 命名規則：runtimeConfig 的鍵加上 `NUXT_` 前綴並轉成大寫底線。
#   sessionPassword    → NUXT_SESSION_PASSWORD
#   public.appName     → NUXT_PUBLIC_APP_NAME
#
# 標記 [必填] 的項目在 production 缺少時，服務會**直接拒絕啟動**
# （見 server/plugins/00.env-validate.ts）。這是刻意的：
# 設定錯誤在部署時就爆掉，好過上線後才在某條路徑上 500。
# ─────────────────────────────────────────────────────────────────────────

# ── Session / 認證 ──────────────────────────────────────────────────────

# [必填] 加密 session cookie 的密鑰，**至少 32 個字元**。
# 每個環境都要用不同的值，且絕對不可提交進版本控制。
# 產生方式：openssl rand -base64 48
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-at-least-32-characters

# session 有效秒數（預設 8 小時）
NUXT_SESSION_MAX_AGE=28800

# ── 外部 API（BFF 的上游）──────────────────────────────────────────────

# [必填] 外部 API 的 base URL。
# 開發時若留空，demo 端點會改用內建假資料（見 server/utils/demo-data.ts）。
NUXT_API_BASE_URL=https://api.example.com

# 外部 API 的靜態金鑰（若上游使用 API key 而非 Bearer token）
NUXT_API_KEY=

# 呼叫上游的逾時毫秒數
NUXT_UPSTREAM_TIMEOUT_MS=10000

# ── 斷路器 ──────────────────────────────────────────────────────────────

# 連續失敗幾次後跳閘，之後的請求會快速失敗而不打上游
NUXT_CIRCUIT_BREAKER_THRESHOLD=5

# 跳閘後多久放行一個請求試探上游是否恢復（毫秒）
NUXT_CIRCUIT_BREAKER_RESET_MS=30000

# ── 資安 ────────────────────────────────────────────────────────────────

# CORS 白名單，多個以逗號分隔。
# 留空 = 只允許同源（最安全，也是大多數專案該用的設定）。
# 絕對不要填 *：本服務使用 cookie 認證，通配符等於允許任何網站代表使用者發請求。
NUXT_CORS_ORIGINS=

# 單一 IP 在時間窗內的最大請求數
NUXT_RATE_LIMIT_MAX=100

# 流量限制的時間窗（毫秒）
NUXT_RATE_LIMIT_WINDOW_MS=60000

# request body 大小上限（bytes，預設 1MB）
NUXT_MAX_BODY_BYTES=1048576

# ── 前端可見的設定（會被打包進瀏覽器，只能放非機密資訊）──────────────

NUXT_PUBLIC_APP_NAME=Frontend Template
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# 登入頁路徑。middleware/auth.ts 的導向與 useAuth().logout() 都讀這個值。
# 預設指向樣板的登入示範（只在開發環境存在），建立自己的登入頁後請改掉。
NUXT_PUBLIC_LOGIN_PATH=/demo/login

# ── 執行環境 ────────────────────────────────────────────────────────────

# 日誌等級：trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# 出現在每筆 log 的服務識別，多服務共用同一個 log 索引時用來區分來源
SERVICE_NAME=frontend-template

# 伺服器埠號
PORT=3000

# 收到 SIGTERM 後，等待負載平衡器把流量移走的時間（毫秒）
SHUTDOWN_DRAIN_MS=10000

# ── 建置期開關 ──────────────────────────────────────────────────────────

# 是否在 production 建置中保留 /demo 示範頁面與 /api/demo/* 端點。
# 預設只有開發環境會有它們；這個開關是給端對端測試用的
# （e2e 跑 production 建置，需要 demo 路由存在才測得到完整鏈路）。
# ⚠️ 正式部署不要設定它。
# ENABLE_DEMO=true
